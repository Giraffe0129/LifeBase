# ===== 数据库配置 =====
# 开发环境：SQLite
DATABASE_URL=sqlite+aiosqlite:///./app.db
# 生产环境推荐 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/my_app

# ===== JWT 密钥（必须修改！） =====
# 生成方法: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# ===== 服务配置 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ===== CORS 跨域白名单（逗号分隔） =====
# 生产环境替换为你的前端域名
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost

# ===== 和风天气 API Key（可选） =====
# 用户也可以在 App 设置页中自行配置
QWEATHER_API_KEY=
